    {
      "title": "Request Duration Percentiles",
      "description": "End-to-end request latency at p50, p95, and p99 percentiles.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
