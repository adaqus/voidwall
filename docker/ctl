#!/usr/bin/env bash
#
# Central control script for the Docker-based dev environment.
#
# Usage:
#   docker/ctl compile             # fetch ONNX Runtime, check licenses, generate
#                                  # notices, build release binaries on the host
#   docker/ctl fetch_models        # fetch and verify the dev stack's model files
#                                  # into models/ (no Hugging Face token needed)
#   docker/ctl start               # compile + fetch_models + start proxy, echo,
#                                  # prometheus, grafana
#   docker/ctl stop                # stop all containers
#   docker/ctl start_echo_server   # start only the echo server container
#   docker/ctl soak                # run soak test against running environment
#   docker/ctl ai4p-eval           # score the voidwall-pii regex engine against
#                                  # AI4Privacy openpii300k (no running proxy needed)
#   docker/ctl piimb-eval          # score the voidwall-pii regex engine on the PII
#                                  # Masking Benchmark's English tasks, with its own
#                                  # metric code (needs python3 3.11+)
#
# Soak test env vars:
#   DURATION   - total test duration  (default: 30m)
#   PEAK_VUS   - peak concurrency     (default: 100)
#
# ai4p-eval env vars:
#   AI4P_LANG      - en|nl|fr|de|it|es, or the English name (default: all six)
#   DATASET        - local JSONL file or directory; fetches nothing when set
#                    (default: fetch into .cache/ai4privacy/)
#   MAX_ROWS       - stop after this many scored rows (default: all)
#   SUPPORTED_ONLY - 1 = leave labels Voidwall has no kind for out of the
#                    table and the totals (default: 0)
#
# piimb-eval env vars:
#   PIIMB_REVISION - benchmark revision for the test data and the metric code
#                    (default: the pinned commit in PIIMB_PINNED_REVISION); the
#                    cache is keyed by this string, so a branch name such as main
#                    is fetched once and not refreshed: delete .cache/piimb/<name>/
#                    to refresh it
#   PIIMB_TASK     - ai4privacy-en|gretel|nemotron-pii|privy: score one task only;
#                    not a full benchmark result (default: all four)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_compile() {
    # Fetch and verify ONNX Runtime, gate licenses, and generate the crate
    # notices before building, so the image never ships a binary without them.
    "$SCRIPT_DIR/fetch-ort.sh"
    echo "Checking dependency licenses..."
    (cd "$PROJECT_DIR" && cargo deny check licenses)
    echo "Generating license notices..."
    mkdir -p "$PROJECT_DIR/target/notices"
    (cd "$PROJECT_DIR" && cargo about generate -m crates/voidwall/Cargo.toml about.hbs \
        -o target/notices/THIRD-PARTY-RUST-CRATES.html)
    echo "Building release binaries..."
    cargo build --release --manifest-path "$PROJECT_DIR/Cargo.toml" 2>&1
    echo "Build complete."
}

cmd_fetch_models() {
    "$SCRIPT_DIR/fetch-models.sh"
}

cmd_start() {
    cmd_compile
    cmd_fetch_models
    echo "Starting dev environment..."
    docker compose -f "$COMPOSE_FILE" up --build -d
    echo ""
    echo "Services:"
    echo "  Proxy:      http://localhost:8082"
    echo "  HTTP API:   http://localhost:8083"
    echo "  Admin:      http://localhost:9090/metrics"
    echo "  Prometheus: http://localhost:9091"
    echo "  Grafana:    http://localhost:3000"
}

cmd_stop() {
    echo "Stopping dev environment..."
    docker compose -f "$COMPOSE_FILE" down
}

cmd_start_echo_server() {
    echo "Starting echo server..."
    docker compose -f "$COMPOSE_FILE" up --build -d echo-server
    echo "Echo server: http://localhost:8090"
}

cmd_soak() {
    echo "Running soak test (DURATION=${DURATION:-30m}, PEAK_VUS=${PEAK_VUS:-100}, CYCLES=${CYCLES:-1})..."
    k6 run \
        -e "PROXY_URL=http://localhost:8082" \
        -e "DURATION=${DURATION:-30m}" \
        -e "PEAK_VUS=${PEAK_VUS:-100}" \
        -e "CYCLES=${CYCLES:-1}" \
        "$PROJECT_DIR/crates/voidwall/benches/k6/soak.js"
}

# The openpii300k train files are JSONL on Hugging Face, public and ungated.
AI4P_BASE="https://huggingface.co/datasets/ai4privacy/pii-masking-300k/resolve/main/data/train"
AI4P_FILES="1english_openpii_30k.jsonl dutch_openpii_28k.jsonl french_openpii_31k.jsonl german_openpii_30k.jsonl italian_openpii_29k.jsonl spanish_openpii_29k.jsonl"

# Print the train file for one AI4P_LANG value, all six for an empty one, or fail.
ai4p_files() {
    local want
    want="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$want" in
        en|english) echo "1english_openpii_30k.jsonl" ;;
        nl|dutch)   echo "dutch_openpii_28k.jsonl" ;;
        fr|french)  echo "french_openpii_31k.jsonl" ;;
        de|german)  echo "german_openpii_30k.jsonl" ;;
        it|italian) echo "italian_openpii_29k.jsonl" ;;
        es|spanish) echo "spanish_openpii_29k.jsonl" ;;
        "")         echo "$AI4P_FILES" ;;
        *)          return 1 ;;
    esac
}

cmd_ai4p_eval() {
    local cache_dir="$PROJECT_DIR/.cache/ai4privacy"
    local lang="${AI4P_LANG:-}"

    local files
    if ! files="$(ai4p_files "$lang")"; then
        echo "Unknown AI4P_LANG='$lang'. Use one of en, nl, fr, de, it, es, or English, Dutch, French, German, Italian, Spanish." >&2
        exit 2
    fi

    local dataset="${DATASET:-}"
    if [ -z "$dataset" ]; then
        mkdir -p "$cache_dir"
        local f
        for f in $files; do
            if [ -s "$cache_dir/$f" ]; then
                echo "Dataset cached: $f"
            else
                echo "Fetching dataset: $f"
                curl -fL --retry 3 -o "$cache_dir/$f.part" "$AI4P_BASE/$f"
                mv "$cache_dir/$f.part" "$cache_dir/$f"
            fi
        done
        # One language reads its file alone; all six read the cache directory.
        if [ -n "$lang" ]; then dataset="$cache_dir/$files"; else dataset="$cache_dir"; fi
    fi

    echo "Running AI4Privacy eval (DATASET=$dataset, AI4P_LANG=${lang:-all}, MAX_ROWS=${MAX_ROWS:-all}, SUPPORTED_ONLY=${SUPPORTED_ONLY:-0})..."
    DATASET="$dataset" AI4P_LANG="$lang" \
        cargo run --release --manifest-path "$PROJECT_DIR/Cargo.toml" \
        -p voidwall-eval --bin ai4privacy-eval
}

# The PII Masking Benchmark is public and ungated on Hugging Face (CC BY-NC 4.0).
# The pin is the revision of 30 of the 35 leaderboard results on 2026-10-14.
PIIMB_REPO="https://huggingface.co/datasets/piimb/pii-masking-benchmark/resolve"
PIIMB_PINNED_REVISION="5f47fff823b3fd7138cfed39e25ca24af8549e25"
PIIMB_TASKS="ai4privacy-en gretel nemotron-pii privy"
PIIMB_FILES="data/test_sentences.jsonl src/piimb/models.py src/piimb/metrics.py"
# What piimb's models.py and metrics.py import, at the versions its uv.lock resolves.
PIIMB_PINS="nervaluate==1.2.1 pydantic==2.13.3 pydantic-extra-types==2.11.1 pycountry==26.2.16 structlog==25.5.0"

cmd_piimb_eval() {
    local tasks="$PIIMB_TASKS"
    if [ -n "${PIIMB_TASK:-}" ]; then
        tasks=""
        local t
        for t in $PIIMB_TASKS; do
            if [ "$PIIMB_TASK" = "$t" ]; then tasks="$t"; fi
        done
        if [ -z "$tasks" ]; then
            echo "Unknown PIIMB_TASK='$PIIMB_TASK'. Use one of: $PIIMB_TASKS." >&2
            exit 2
        fi
    fi

    if ! command -v python3 >/dev/null; then
        echo "piimb-eval needs python3 (3.11 or later) on the host to run the benchmark's metric code." >&2
        exit 2
    fi
    if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
        echo "piimb-eval needs python3 3.11 or later; found $(python3 --version 2>&1)." >&2
        exit 2
    fi

    local revision="${PIIMB_REVISION:-$PIIMB_PINNED_REVISION}"
    local rev_dir="$PROJECT_DIR/.cache/piimb/$revision"
    local f
    for f in $PIIMB_FILES; do
        if [ -s "$rev_dir/$f" ]; then
            echo "Benchmark cached: $f"
        else
            echo "Fetching benchmark: $f @ $revision"
            mkdir -p "$(dirname "$rev_dir/$f")"
            curl -fL --retry 3 -o "$rev_dir/$f.part" "$PIIMB_REPO/$revision/$f"
            mv "$rev_dir/$f.part" "$rev_dir/$f"
        fi
    done

    # One venv for every revision; the marker records what it holds.
    local venv="$PROJECT_DIR/.cache/piimb/venv"
    if [ "$(cat "$venv/.voidwall-pins" 2>/dev/null)" != "$PIIMB_PINS" ]; then
        echo "Installing the metric code's Python packages into .cache/piimb/venv..."
        rm -rf "$venv"
        if ! python3 -m venv "$venv"; then
            echo "Cannot create a Python venv; install the venv module (on Debian/Ubuntu: python3-venv)." >&2
            exit 2
        fi
        "$venv/bin/pip" install --quiet --disable-pip-version-check $PIIMB_PINS
        echo "$PIIMB_PINS" > "$venv/.voidwall-pins"
    else
        echo "Python packages installed: .cache/piimb/venv"
    fi

    echo "Writing spans (tasks: $tasks)..."
    local spans="$rev_dir/voidwall-spans.jsonl"
    cargo run --release --quiet --manifest-path "$PROJECT_DIR/Cargo.toml" \
        -p voidwall-eval --bin piimb-spans -- "$rev_dir/data/test_sentences.jsonl" $tasks \
        > "$spans.part"
    mv "$spans.part" "$spans"

    "$venv/bin/python" -I "$PROJECT_DIR/crates/voidwall-eval/piimb/score.py" \
        "$rev_dir/src" "$rev_dir/data/test_sentences.jsonl" "$spans" "$revision" $tasks
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

usage() {
    echo "Usage: $0 {compile|fetch_models|start|stop|start_echo_server|soak|ai4p-eval|piimb-eval}"
    exit 1
}

case "${1:-}" in
    compile)          cmd_compile ;;
    fetch_models)     cmd_fetch_models ;;
    start)            cmd_start ;;
    stop)             cmd_stop ;;
    start_echo_server) cmd_start_echo_server ;;
    soak)             cmd_soak ;;
    ai4p-eval)        cmd_ai4p_eval ;;
    piimb-eval)       cmd_piimb_eval ;;
    *)                usage ;;
esac
