          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(pii_proxy_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
