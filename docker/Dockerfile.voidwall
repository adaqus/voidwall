FROM debian:trixie-slim

LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.source="https://github.com/adaqus/voidwall"

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The default models, fetched and verified by `docker/fetch-models.sh`, with
# their licenses. They change least, so they come first and a rebuild with the
# same models reuses their layers. The dev stack mounts its own copies over
# these.
COPY models/wolf-small/ /opt/voidwall/models/wolf-small/
COPY models/bards-v2/ /opt/voidwall/models/bards-v2/

# The default config: the REST API on, the reverse proxy off. `--config` beats
# the variable, so the dev stack's `command` picks its own file.
COPY docker/voidwall-image.toml /etc/voidwall/voidwall.toml
ENV VOIDWALL_CONFIG=/etc/voidwall/voidwall.toml

COPY target/release/voidwall /usr/local/bin/voidwall

# License notices for everything linked into the binary: the Rust crates
# (generated by `docker/ctl compile`), ONNX Runtime, pyke's build, Eigen, and
# Oniguruma (C code inside the `onig_sys` crate, BSD-2-Clause).
COPY target/notices/THIRD-PARTY-RUST-CRATES.html /usr/share/doc/voidwall/
COPY licenses/ /usr/share/doc/voidwall/

# Voidwall's own license and attribution notice.
COPY LICENSE NOTICE /usr/share/doc/voidwall/

# No step needs root: ports are above 1024 and nothing is written at runtime.
# Numeric, so Kubernetes `runAsNonRoot` can verify it without /etc/passwd.
USER 65532:65532

# Set by the release workflow; a dev build leaves them empty.
ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENTRYPOINT ["voidwall"]
